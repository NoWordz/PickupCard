{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contributors": ["${mod_credits}"],
  "contact": {
    "homepage": "${mod_repo_url}",
    "sources": "${mod_repo_url}",
    "issues": "${issue_tracker_url}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.niuqu.pickupcard.PickupCard"],
    "modmenu": ["com.niuqu.pickupcard.client.PickupCardModMenu"]
  },
  "accessWidener": "pickupcard.accesswidener",
  "mixins": ["pickupcard.mixins.json"],
  "depends": {
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabricloader": ">=0.16.10",
    "fabric-api": "${fabric_api_requirement}",
    "forgeconfigapiport": ">=8.0.3"
  },
  "suggests": {
    "modmenu": "*"
  }
}
